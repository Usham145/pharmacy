# Production-style PostgreSQL connection for ArogyaMitra
DATABASE_URL=postgresql+psycopg://pharmacy:pharmacy@localhost:5432/pharmacy
SECRET_KEY=replace-this-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEAR_EXPIRY_DAYS=90
ADMIN_ALERT_EMAIL=admin@hospital.example
PHARMACIST_ALERT_EMAIL=pharmacist@hospital.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=pharmacy@hospital.example
SMTP_USE_TLS=true
PROCUREMENT_UNIT_PRICE=50
